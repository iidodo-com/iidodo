# kabuステーションAPI（providers/kabu.py）。このファイルを .env にコピーして使う。.env は git に入れない。
# APIパスワード（kabuステーション側で「APIを利用する」に設定したもの）
KABU_API_PASSWORD=
# test = 検証用(ポート18081, 既定) / production = 本番(ポート18080)。本番は明示的に production と書いた時だけ有効。
KABU_ENV=test
# kabuステーションが動いているホスト（Windows上で動かす前提のため通常は localhost）
KABU_HOST=localhost

# 以下は config.yaml の値を上書きする（任意）
# PROVIDER=mock        # mock | replay | kabu | tachibana
# REPLAY_SPEED=10      # 1 / 10 / 60
# REPLAY_DATE=2026-10-01
# MOCK_SPEED=60
