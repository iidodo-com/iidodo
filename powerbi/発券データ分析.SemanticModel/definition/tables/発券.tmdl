		sourceColumn: 待ち秒合計

	partition 発券 = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\hakken_15min.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"日付", type date}, {"区", type text}, {"区分名", type text}, {"発券時", Int64.Type}, {"分台", Int64.Type}, {"時間帯キー", Int64.Type}, {"PDF表記", type text}, {"件数", Int64.Type}, {"待ち秒合計", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
