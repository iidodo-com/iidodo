table 発券
	lineageTag: dc8cc2bf-2ba4-401a-be21-b50ebc6fe426

	measure 発券数 = SUM('発券'[件数])
		formatString: #,0
		lineageTag: c02505d8-94d9-4550-b6fd-51d9da6eca42

	measure 全体に占める割合 = DIVIDE([発券数], CALCULATE([発券数], REMOVEFILTERS('発券'[時間帯キー], '発券'[PDF表記])), 0)
		formatString: 0.0%
		lineageTag: c583d619-0261-4cd8-99ab-52057082c1d8

	column 日付
