		summarizeBy: none
		sourceColumn: [開始分]

	column 終了分
		dataType: int64
		lineageTag: f1deb3b7-78c4-4bb3-8048-835bc5e360f8
		summarizeBy: none
		sourceColumn: [終了分]

	partition 開庁時間案 = calculated
		mode: import
		source = DATATABLE("開庁時間案", STRING, "開始分", INTEGER, "終了分", INTEGER, { {"9:00-16:30", 540, 990}, {"8:45-16:30", 525, 990}, {"8:30-17:15", 510, 1035} })
