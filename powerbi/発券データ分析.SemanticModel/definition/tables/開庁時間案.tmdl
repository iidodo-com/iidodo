table 開庁時間案
	lineageTag: c4fb5268-454e-49a0-9c75-0f905d8149b8

	measure 開庁時間内の発券数 = VAR s = MAX('開庁時間案'[開始分]) VAR e = MAX('開庁時間案'[終了分]) RETURN CALCULATE(SUM('発券'[件数]), KEEPFILTERS(FILTER(ALL('発券'[時間帯キー]), '発券'[時間帯キー] >= s && '発券'[時間帯キー] <= e)))
		formatString: #,0
		lineageTag: c3830bb3-61ea-4845-aca4-e71c52478298

	measure 開庁時間外の発券数 = CALCULATE(SUM('発券'[件数]), REMOVEFILTERS('発券'[時間帯キー], '発券'[PDF表記])) - [開庁時間内の発券数]
		formatString: #,0
		lineageTag: b3e711a8-2aa5-4752-af35-b5ad62f70b77

	measure 開庁時間外の発券数割合 = DIVIDE([開庁時間外の発券数], CALCULATE(SUM('発券'[件数]), REMOVEFILTERS('発券'[時間帯キー], '発券'[PDF表記])), 0)
		formatString: 0.0%
		lineageTag: 1e826b21-ab9f-4ad7-ac6a-2686c37549e3

	column 開庁時間案
